{
  "name": "@bwin/sankey-plus",
  "version": "2.0.0",
  "license": "MIT",
  "author": "Benjamin Winkler | bwin",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./dist/sankey-plus.js",
  "types": "./dist/index.d.ts",
  "description": "An interactive React Sankey component with four-sided node placement, partial allocations and controlled selection.",
  "keywords": [
    "sankey",
    "react",
    "flow-diagram",
    "data-visualization",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bwin/sankey-plus.git"
  },
  "homepage": "https://github.com/bwin/sankey-plus#readme",
  "bugs": {
    "url": "https://github.com/bwin/sankey-plus/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/sankey-plus.js"
    },
    "./style.css": {
      "types": "./dist/style.css.d.ts",
      "default": "./dist/style.css"
    }
  },
  "files": [
    "dist/sankey-plus.js",
    "dist/style.css",
    "dist/style.css.d.ts",
    "dist/index.d.ts",
    "dist/SankeyDiagram.d.ts",
    "dist/types.d.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "node scripts/test.mjs",
    "stress": "node scripts/benchmark-layout.mjs --case stress-100-300",
    "benchmark": "node scripts/benchmark-layout.mjs",
    "build": "node scripts/build.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "preview": "node scripts/serve.mjs"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "rollup": "^4.65.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
